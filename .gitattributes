# Everything executed or read inside the Linux Dev Container stays LF, whatever
# core.autocrlf says on the developer's machine. A CRLF shebang ("#!/bin/bash\r")
# makes the kernel look for an interpreter named "bash\r" and fail with
# "not found" -- which is exactly how this bit the lab on Windows.
* text=auto eol=lf

# Binary assets git should never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary
